{
  "name": "devlog",
  "version": "1.0.0",
  "private": true,
  "description": "Jot work notes on your phone, get a ready-to-paste standup each morning. Offline-first PWA, no server, no API keys.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
