{
  "name": "devlog",
  "version": "0.4.0",
  "private": true,
  "description": "Jot work notes on your phone, get an AI standup each morning. Offline-first PWA.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build",
    "eval": "esbuild scripts/eval-standup.ts --bundle --platform=node --format=esm --packages=external --outfile=.eval/eval.mjs --log-level=warning && node .eval/eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "preact": "10.29.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
