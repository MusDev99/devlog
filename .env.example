# Vercel → Project → Settings → Environment Variables. Placeholders only, never commit real values.
# Without the sign-in variables, /api/auth/* return 503 and the app runs local-only (nothing syncs).

# Signs the session cookies. At least 32 characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=change-me-to-a-long-random-string-of-48-chars
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Public origin of this deploy, no trailing slash (never taken from the request).
APP_URL=https://your-devlog.vercel.app
# Optional: comma-separated emails allowed to sign in. Empty = any Google account can register.
ALLOWED_EMAILS=

# Google Sheet record. Service account (IAM → Service accounts → Keys → JSON): its email and private key.
# Share the spreadsheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=devlog@your-project.iam.gserviceaccount.com
# Keep it on one line with \n for newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# The id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
