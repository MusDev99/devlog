# Vercel → Project → Settings → Environment Variables. Placeholders only, never commit real values.
# Without all of the sign-in variables, /api/auth/* and /api/standup return 503 and the app uses its rule-based standup.

# Claude API key for the AI standup.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional model override (default claude-opus-5-5).
# STANDUP_MODEL=claude-opus-5-5

# Signs the session cookies. At least 32 characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Public origin of this deploy, no trailing slash (never taken from the request).
APP_URL=https://your-devlog.vercel.app
# Comma-separated Google accounts allowed to use the AI standup.
ALLOWED_EMAILS=you@example.com
